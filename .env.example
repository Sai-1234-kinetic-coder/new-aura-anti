# =============================================================================
# AuraFit Environment Configuration (SIH 2026 | Problem Statement SIH26196)
# =============================================================================

# 1. High-Concurrency Supabase PostgreSQL Database (Recommended for Campus Scale)
# Creates atomic transactions, sub-millisecond Department Wars leaderboards, and WebSockets.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 2. Firebase Cloud Configuration (Authentication & Hosting)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 3. Optional: Google Gemini API Key for Live Streaming AI Coaching
VITE_GEMINI_API_KEY=your_gemini_api_key
