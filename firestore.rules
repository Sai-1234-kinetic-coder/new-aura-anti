rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // users/{uid}
    //   - Authenticated users can READ profiles (needed for department leaderboard)
    //   - Owner can CREATE with initial cap (max 150 starter XP, 0 squats)
    //   - Owner can UPDATE with strictly bounded point deltas (max +200 pts, max +25 squats/tx)
    //   - Prevents cheating/spoofing (e.g. setting totalPoints: 999999)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.totalPoints is int
                    && request.resource.data.totalPoints >= 0
                    && request.resource.data.totalPoints <= 150
                    && request.resource.data.squatCount is int
                    && request.resource.data.squatCount == 0;
      allow update: if request.auth != null && request.auth.uid == userId
                    && (
                      // Total points delta must be positive and max 200 XP per write
                      !('totalPoints' in request.resource.data) ||
                      (
                        request.resource.data.totalPoints is int &&
                        request.resource.data.totalPoints >= resource.data.totalPoints &&
                        request.resource.data.totalPoints <= resource.data.totalPoints + 200
                      )
                    )
                    && (
                      // Squat count increment must be positive and max 25 reps per batch
                      !('squatCount' in request.resource.data) ||
                      (
                        request.resource.data.squatCount is int &&
                        request.resource.data.squatCount >= resource.data.squatCount &&
                        request.resource.data.squatCount <= resource.data.squatCount + 25
                      )
                    );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // workouts/{workoutId}
    //   - Authenticated users can CREATE a workout for themselves only
    //   - Points earned must be integer between 0 and 200
    //   - READ is restricted to the document owner (userId field matches auth uid)
    // -------------------------------------------------------------------------
    match /workouts/{workoutId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.pointsEarned is int
                    && request.resource.data.pointsEarned >= 0
                    && request.resource.data.pointsEarned <= 200;
      allow read:   if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // daily_logs/{userId}/entries/{date}
    //   - Strictly private: only the owner can read/write their own daily log
    // -------------------------------------------------------------------------
    match /daily_logs/{userId}/entries/{date} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // buddy_requests/{requestId}
    //   - Authenticated users can CREATE a request (fromUid must match their uid)
    //   - READ restricted to requests you sent (fromUid)
    // -------------------------------------------------------------------------
    match /buddy_requests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if request.auth != null
                    && (resource.data.fromUid == request.auth.uid || resource.data.toBuddyProfileId == request.auth.uid);
      allow update: if request.auth != null
                    && resource.data.toBuddyProfileId == request.auth.uid;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Deny all other paths by default
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
